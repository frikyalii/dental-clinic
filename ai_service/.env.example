# Free Hugging Face token: https://huggingface.co/settings/tokens
# Create a fine-grained token with the permission "Make calls to Inference Providers".
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Open-weight chat model served by HF Inference Providers (must support tool calling).
# Other options: meta-llama/Llama-3.3-70B-Instruct (accept licence on HF first), Qwen/Qwen3-32B, Qwen/Qwen2.5-7B-Instruct
# Optional provider suffix: openai/gpt-oss-120b:cerebras   or   :fastest / :cheapest
AI_MODEL=openai/gpt-oss-120b

# Hosted embedding model (HF feature-extraction, no local download)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CLINIC_API_URL=http://localhost:5001/api

# Reranking: "llm" (default) scores retrieved passages with the chat model; "none" disables reranking and relevance grading
RERANK_BACKEND=llm

# OCR for scanned PDFs and images: "vlm" (hosted HF vision model, default), "tesseract" (local, optional) or "none"
OCR_BACKEND=vlm
OCR_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
OCR_MAX_PAGES=10
